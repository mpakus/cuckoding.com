<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Cuckoding" suffix=" · Local agent orchestration">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" sizes="any" href={~p"/favicon.ico"} />
    <link rel="icon" type="image/svg+xml" href={~p"/assets/images/brand-icon.svg"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="min-h-screen text-slate-900 antialiased">
    <a
      href="#main-content"
      class="sr-only z-50 rounded bg-white px-4 py-3 font-medium text-slate-950 focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:outline-2 focus:outline-offset-2"
    >
      Skip to content
    </a>
    {@inner_content}
  </body>
</html>
