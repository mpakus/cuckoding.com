{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "acceptance", "issues"],
  "properties": {
    "verdict": {"type": "string", "enum": ["approved", "changes_requested", "needs_spec_revision"]},
    "summary": {"type": "string"},
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": {"type": "string"},
          "status": {"type": "string", "enum": ["passed", "failed", "unclear"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "message"],
        "properties": {
          "criterion": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    }
  }
}
