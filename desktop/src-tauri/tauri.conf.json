{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCoding",
  "version": "0.1.0",
  "identifier": "com.cuckoding.rebuild",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../resources/release/": "release/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  }
}
