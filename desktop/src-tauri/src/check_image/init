#!/bin/sh
set -e
B=/bin/busybox
trap '$B poweroff -f' EXIT
$B mount -t devtmpfs devtmpfs /dev
$B mount -t proc proc /proc
$B mount -t sysfs sysfs /sys
$B mount -t cgroup2 none /sys/fs/cgroup
$B chmod 600 /dev/hvc0 /dev/console
echo '+pids +memory +cpu' > /sys/fs/cgroup/cgroup.subtree_control
$B mkdir /sys/fs/cgroup/work /run/check /tmp/home
$B chmod 700 /run/check
$B chmod 1777 /tmp
$B chown 1000:1000 /tmp/home
echo 128 > /sys/fs/cgroup/work/pids.max
echo 536870912 > /sys/fs/cgroup/work/memory.max
echo 0 > /sys/fs/cgroup/work/memory.swap.max
echo 1 > /sys/fs/cgroup/work/memory.oom.group
echo '100000 100000' > /sys/fs/cgroup/work/cpu.max
# Independent of the controller and project resource group.
($B sleep 320; echo 1 > /sys/fs/cgroup/work/cgroup.kill; $B poweroff -f) &
export PATH=/opt/elixir/bin:/usr/bin:/bin HOME=/tmp/home LANG=C.UTF-8
export ERL_FLAGS='+S 2:2 +SDcpu 1 +SDio 1 +A 1' HEX_OFFLINE=1 MIX_ENV=test
/usr/bin/node /control.mjs
echo 1 > /sys/fs/cgroup/work/cgroup.kill
trap - EXIT
$B poweroff -f
