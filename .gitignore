# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Finder metadata is not project documentation.
.DS_Store

# Ignore package tarball (built via "mix hex.build").
cuckoding-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json
/priv/static/**/*.gz
/priv/static/favicon-*.ico
/priv/static/robots-*.txt
/priv/static/images/logo-*.svg

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Database files
*.db
*.db-*
*.sqlite3
*.sqlite3-*

# Run-owned project checkouts and runtime state
/workspaces/

# Language server and Dialyzer PLTs
.elixir_ls/
/priv/plts/

# Desktop / Tauri / Burrito build output
/src-tauri/target/
/src-tauri/gen/
/burrito_out/

# Discovery spike build output
/spikes/0003-menubar-release/control_plane/_build/
/spikes/0003-menubar-release/control_plane/deps/
/spikes/0003-menubar-release/shell/release/
/spikes/0003-menubar-release/shell/src-tauri/gen/
/spikes/0003-menubar-release/shell/src-tauri/target/
/desktop/release/
/desktop/dist/
/desktop/dist-backup.*/
/desktop/src-tauri/gen/
/desktop/src-tauri/target/
