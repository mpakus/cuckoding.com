#!/bin/sh
# This single-user application has no distributed Erlang/RPC listener.
export RELEASE_DISTRIBUTION=none
export ERL_CRASH_DUMP=/dev/null
case "$RELEASE_COMMAND" in
  start|start_iex) export PHX_SERVER=true ;;
  daemon|daemon_iex)
    echo "BOSS runs in the foreground; use bin/boss start." >&2
    exit 64
    ;;
esac
