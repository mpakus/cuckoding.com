#!/usr/bin/env python3
"""Dependency-free checks for the exact directory published to Pages."""
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import urlsplit
import re
import xml.etree.ElementTree as ET

root = Path(__file__).resolve().parents[1]
site = root / "site"


class Page(HTMLParser):
    def __init__(self):
        super().__init__()
        self.ids, self.refs, self.tags, self.text = [], [], [], []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        self.tags.append((tag, attrs))
        if "id" in attrs:
            self.ids.append(attrs["id"])
        for key in ("src", "href"):
            if key in attrs:
                self.refs.append(attrs[key])
        if tag == "img":
            assert attrs.get("alt") or attrs.get("aria-hidden") == "true", "Images need alternative text or explicit decoration"
            assert int(attrs["width"]) > 0 and int(attrs["height"]) > 0
        assert not any(key.startswith("on") for key in attrs), "Keep scripts external"
        if tag in ("script", "iframe"):
            assert not urlsplit(attrs.get("src", "")).netloc, "No third-party scripts"

    def handle_data(self, text):
        self.text.append(text)


page = Page()
page.feed((site / "index.html").read_text())
assert len(page.ids) == len(set(page.ids)), "Duplicate element IDs"
for ref in page.refs:
    url = urlsplit(ref)
    if url.scheme or url.netloc:
        assert url.scheme == "https", f"Unsafe public link: {ref}"
        continue
    assert not url.path.startswith("/"), f"Use project-path-safe assets: {ref}"
    if url.path:
        target = (site / url.path).resolve()
        assert target.is_relative_to(site) and target.is_file(), f"Missing local file: {ref}"
    if url.fragment and not url.path:
        assert url.fragment in page.ids, f"Missing anchor: {ref}"
assert sum(tag == "h1" for tag, _ in page.tags) == 1
assert sum(tag == "main" for tag, _ in page.tags) == 1
assert any(tag == "html" and attrs.get("lang") == "en" for tag, attrs in page.tags)
assert any(tag == "meta" and attrs.get("name") == "viewport" for tag, attrs in page.tags)
assert any(tag == "a" and attrs.get("class") == "skip" for tag, attrs in page.tags)
assert any(tag == "button" and attrs.get("id") == "motion-toggle" and "hidden" in attrs for tag, attrs in page.tags)
text = " ".join(page.text)
for claim in ("In development", "Planned workflow", "Satirical concept art", "Not a product screenshot", "Detection does not authorize", "not a signed or notarized public release", "Speculator", "Implementor", "Secutor", "Summa Rudis"):
    assert claim in text, f"Missing public scope/provenance: {claim}"
assert "prefers-reduced-motion: reduce" in (site / "style.css").read_text()
assert (site / "CNAME").read_text().strip() == "cuckoding.com"
assert (site / ".nojekyll").is_file()
ET.parse(site / "sitemap.xml")
ET.parse(site / "assets/favicon.svg")
assert (site / "assets/mark.svg").read_bytes() == (root / "desktop/mark.svg").read_bytes()
assert (site / "assets/favicon.svg").read_bytes() == (root / "priv/static/favicon.svg").read_bytes()
assert sum("data-parallax" in attrs for _, attrs in page.tags) == 4
assert sum(attrs.get("class", "").startswith("character ") for _, attrs in page.tags) == 7
assert sum(attrs.get("class") == "scene-back" for _, attrs in page.tags) == 4
assert "CCoding" not in (site / "index.html").read_text()
assert not re.search(r"\bemperor\b", text)
for tag, attrs in page.tags:
    if tag == "img" and attrs.get("data-motion"):
        asset = site / attrs["src"]
        assert asset.stat().st_size < 6_000_000
        if attrs["data-motion"] != "depth":
            assert asset.read_bytes()[25] == 6, f"Foreground needs RGBA transparency: {asset}"
        if attrs.get("fetchpriority") != "high":
            assert attrs.get("loading") == "lazy"
for id in ("arena-art", "hero-art", "revel-art", "doom-art"):
    assert any(attrs.get("id") == id and attrs.get("role") == "img" and attrs.get("aria-label") for _, attrs in page.tags)
assert '"productName": "Cuckoding"' in (root / "desktop/src-tauri/tauri.conf.json").read_text()
for file in site.rglob("*"):
    assert not file.is_symlink(), f"Pages cannot publish symlinks: {file}"
workflow = (root / ".github/workflows/pages.yml").read_text()
assert "path: site\n" in workflow
assert all(re.fullmatch(r"[0-9a-f]{40}", pin) for pin in re.findall(r"uses: [^@]+@(\S+)", workflow))
assert "needs: check" in workflow and "github.event_name != 'pull_request'" in workflow
print(f"PASS: {len(page.refs)} links/assets, accessibility structure, scope/provenance, motion fallback and Pages boundary")
