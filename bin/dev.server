#!/usr/bin/env python3
"""Source UI server: private dev data, real shell handshake and Phoenix live reload."""
import argparse
import fcntl
import http.client
import json
import os
from pathlib import Path
import queue
import secrets
import shutil
import signal
import subprocess
import threading
import time


def tool(name):
    path = shutil.which(name)
    if not path:
        raise RuntimeError(f"Install {name} first (see docs/DEVELOPMENT.md).")
    if "/shims/" in path:
        path = subprocess.check_output(["rtk", "proxy", "asdf", "which", name], text=True).strip()
    return str(Path(path).resolve())


def private_directory(path):
    if path.resolve() != path:
        raise RuntimeError(f"Refusing linked development storage: {path}")
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)


def request(port, path, token):
    conn = http.client.HTTPConnection("127.0.0.1", port, timeout=3)
    try:
        conn.request("POST", path, headers={"authorization": "Bearer " + token})
        response = conn.getresponse()
        if response.status not in (200, 202):
            raise RuntimeError(f"Development handshake failed: {response.status}")
        return json.loads(response.read(8192))
    finally:
        conn.close()


def smoke(port, shell):
    def fetch(method, path, body=None, headers=None):
        conn = http.client.HTTPConnection("127.0.0.1", port, timeout=30)
        try:
            conn.request(method, path, body=body, headers=headers or {})
            response = conn.getresponse()
            return response.status, dict(response.getheaders()), response.read().decode()
        finally:
            conn.close()

    for path in ("/tidewave/mcp", "/tidewave/config", "/tidewave/connect"):
        assert fetch("GET", path)[0] == 404
    assert fetch("POST", "/tidewave/mcp")[0] == 404
    assert fetch("GET", "/")[0] == 302
    for headers in ({"origin": "https://foreign.invalid"}, {"host": "foreign.invalid"},
                    {"sec-fetch-site": "cross-site"}):
        assert fetch("GET", "/", headers=headers)[0] == 403
    handoff = request(port, "/shell/open", shell)["token"]
    status, headers, _ = fetch("GET", "/open?token=" + handoff)
    assert status == 302
    cookie = headers["set-cookie"].split(";", 1)[0]
    assert fetch("GET", "/open?token=" + handoff)[0] == 401
    status, headers, html = fetch("GET", "/", headers={"cookie": cookie})
    assert status == 200 and "Tabula Gladiatorum" in html
    assert "tidewave" not in html.lower()
    assert "/phoenix/live_reload/frame" in html and "data-phx-loc" in html
    assert "tidewave" not in headers["content-security-policy"]
    assert "unsafe-" not in headers["content-security-policy"]
    assert "frame-ancestors 'none'" in headers["content-security-policy"]
    assert headers["x-frame-options"] == "DENY"
    status, headers, _ = fetch("GET", "/phoenix/live_reload/frame")
    assert status == 200 and "'unsafe-inline'" in headers["content-security-policy"]
    assert "frame-ancestors 'self'" in headers["content-security-policy"]
    assert headers["x-frame-options"] == "SAMEORIGIN"
    assert "unsafe-eval" not in headers["content-security-policy"]
    print("Development smoke passed: session, reload, origins, strict app CSP and no Tidewave.", flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=4000)
    parser.add_argument("--no-open", action="store_true", help="do not open the browser")
    parser.add_argument("--smoke", action="store_true", help="check development integration, then stop")
    args = parser.parse_args()
    if not 0 <= args.port <= 65535:
        parser.error("port must be between 0 and 65535")
    project = Path(__file__).resolve().parent.parent
    os.chdir(project)
    root = project / ".ccoding" / "ui-dev"
    private_directory(root)
    # Same flock as the native shell; no second owner can share this data root.
    lock = os.open(root / "shell.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(lock)
        raise RuntimeError(
            "Cuckoding UI development is already running for this checkout.\n"
            "Use its open browser tab, or stop its launcher with Ctrl-C and run this command again.\n"
            "A different --port still shares the same data. Do not delete shell.lock."
        ) from None
    helper = project / "desktop/src-tauri/target/release/bundle/macos/Cuckoding.app/Contents/MacOS/ccoding"
    if not helper.is_file():
        raise RuntimeError("Build the native helper first: rtk proxy bin/dev.build")
    runtime_home = root / "runtime-home"
    # Storage.prepare! requires the marker before runtime directories are added.
    marker = root / ".ccoding-rebuild-v1"
    if not marker.exists():
        if set(p.name for p in root.iterdir()) != {"shell.lock"}:
            raise RuntimeError("Unrecognized UI development data; preserve it and inspect first.")
        with marker.open("x") as file:
            file.write("ccoding-rebuild-v1\n")
        marker.chmod(0o600)
    elif marker.is_symlink() or marker.read_text() != "ccoding-rebuild-v1\n":
        raise RuntimeError("Invalid UI development data marker")
    private_directory(runtime_home)
    rtk, mix, elixir, erl = [tool(name) for name in ("rtk", "mix", "elixir", "erl")]
    bootstrap = secrets.token_hex(32)
    boot = root / ("launch-" + secrets.token_hex(12))
    fd = os.open(boot, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as file:
        json.dump({"bootstrap": bootstrap, "signing": secrets.token_hex(64)}, file)
    env = {
        "PATH": os.pathsep.join(dict.fromkeys([str(Path(p).parent) for p in (rtk, mix, elixir, erl)]))
        + ":/usr/bin:/bin:/usr/sbin:/sbin",
        "HOME": str(runtime_home),
        "MIX_HOME": str(runtime_home / ".mix"),
        "HEX_HOME": str(runtime_home / ".hex"),
        # Only installed tool archives are reused, never personal Mix/Hex config.
        "MIX_ARCHIVES": os.environ.get("MIX_ARCHIVES", str(Path.home() / ".mix/archives")),
        "MIX_ENV": "dev",
        "LANG": "en_US.UTF-8",
        "TZ": "UTC",
        "CCODING_DEV_PORT": str(args.port),
        "CCODING_DATA_DIR": str(root),
        "CCODING_BOOTSTRAP_FILE": str(boot),
        "CCODING_NATIVE_HELPER": str(helper),
    }
    child = None
    shell = None
    port = None
    stopped = threading.Event()
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda *_: stopped.set())
    try:
        child = subprocess.Popen([rtk, "proxy", mix, "phx.server"], cwd=project, env=env,
                                 stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, text=True, start_new_session=True)
        ready = queue.Queue(maxsize=1)

        def output():
            for line in child.stdout:
                if line.startswith("CCODING_READY "):
                    ready.put(json.loads(line.removeprefix("CCODING_READY "))["port"])
                else:
                    print(line, end="", flush=True)

        threading.Thread(target=output, daemon=True).start()
        deadline = time.monotonic() + 120
        while port is None and not stopped.is_set():
            if child.poll() is not None or time.monotonic() > deadline:
                raise RuntimeError("Development server did not start")
            try:
                port = ready.get(timeout=0.1)
            except queue.Empty:
                pass
        if port is None:
            return
        shell = request(port, "/shell/bootstrap", bootstrap)["token"]
        print(f"Cuckoding UI development: http://127.0.0.1:{port}", flush=True)
        print("Press Ctrl-C to stop. Development data stays in .ccoding/ui-dev.", flush=True)
        if args.smoke:
            smoke(port, shell)
            return
        if not args.no_open:
            handoff = request(port, "/shell/open", shell)["token"]
            subprocess.run(["/usr/bin/open", f"http://127.0.0.1:{port}/open?token={handoff}"], check=True)
        while not stopped.wait(5):
            request(port, "/shell/status", shell)
    finally:
        if shell:
            try:
                request(port, "/shell/quit", shell)
            except (OSError, RuntimeError):
                pass
        if child:
            try:
                child.wait(timeout=8)
            except subprocess.TimeoutExpired:
                os.killpg(child.pid, signal.SIGTERM)
                try:
                    child.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    os.killpg(child.pid, signal.SIGKILL)
                    child.wait()
        boot.unlink(missing_ok=True)
        os.close(lock)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError) as error:
        raise SystemExit(str(error)) from None
