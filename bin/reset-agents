#!/usr/bin/env python3
"""Reset ALL local Cuckoding state, retaining a private recoverable archive."""
import argparse
from contextlib import closing
from datetime import datetime, timezone
import fcntl
import json
import os
from pathlib import Path
import sqlite3
import stat
import tempfile


MARKER = ".ccoding-rebuild-v1"
MARKER_BYTES = b"ccoding-rebuild-v1\n"


def regular(path):
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.geteuid():
        raise RuntimeError(f"Refusing unsafe storage file: {path}")
    return info


def validate(root):
    project = Path(__file__).resolve().parent.parent
    if root.resolve() != root or root in (Path.home(), *project.parents, project):
        raise RuntimeError("Use an app-owned canonical data directory, not a home/project/system root.")
    info = root.stat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077:
        raise RuntimeError("Data directory must be owned by you and private (0700).")
    if (root / ".git").exists() or (root / ".git").is_symlink():
        raise RuntimeError("Refusing to reset a project checkout.")
    marker = root / MARKER
    if regular(marker).st_size != len(MARKER_BYTES) or marker.read_bytes() != MARKER_BYTES:
        raise RuntimeError("Unrecognized Cuckoding data marker; nothing was reset.")
    return info.st_dev, info.st_ino


def settled(root):
    database = root / "foundation.db"
    if not database.exists() and not database.is_symlink():
        if any(p.name not in (MARKER, "shell.lock") for p in root.iterdir()):
            raise RuntimeError("Database missing from non-empty storage; preserve and inspect it first.")
        return
    regular(database)
    for suffix in ("-wal", "-shm", "-journal"):
        sidecar = root / ("foundation.db" + suffix)
        if sidecar.exists() or sidecar.is_symlink():
            regular(sidecar)
    with closing(sqlite3.connect(database.as_uri() + "?mode=ro", uri=True, timeout=1)) as connection:
        if connection.execute("PRAGMA integrity_check").fetchall() != [("ok",)]:
            raise RuntimeError("SQLite integrity check failed; preserve and inspect this workspace.")
        if connection.execute("PRAGMA foreign_key_check").fetchall():
            raise RuntimeError("SQLite foreign-key check failed; preserve and inspect this workspace.")
        busy = connection.execute(
            "SELECT COUNT(*) FROM commands WHERE state IN ('pending','running','cancelling')"
        ).fetchone()[0]
        battles = connection.execute(
            "SELECT COUNT(*) FROM battles WHERE state IN "
            "('running','pausing','paused','stopping','needs_attention')"
        ).fetchone()[0]
        if busy or battles:
            raise RuntimeError("Finish/stop active or unresolved work before reset. This script never stops workers.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--data-dir", type=Path, default=Path(os.environ.get(
        "CCODING_DATA_DIR", Path.home() / "Library/Application Support/CCoding Rebuild")))
    parser.add_argument("--yes", action="store_true", help="confirm resetting the displayed workspace without typing RESET")
    args = parser.parse_args()
    root = args.data_dir.expanduser().absolute()
    identity = validate(root)
    lock_path = root / "shell.lock"
    if lock_path.exists() or lock_path.is_symlink():
        regular(lock_path)
    descriptor = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError("Cuckoding is running. Quit it first; do not delete shell.lock.") from None
        settled(root)
        print(f"Data directory: {root}", flush=True)
        print("Reset ALL agents, private profiles, roles, Arenas/projects, boards, tasks, history and app artifacts.")
        print("A private sibling archive retains everything. External project folders and personal provider profiles stay untouched.")
        if not args.yes:
            try:
                confirmed = input("Type RESET to continue: ") == "RESET"
            except EOFError:
                confirmed = False
            if not confirmed:
                print("Cancelled; nothing was reset.")
                return
        if validate(root) != identity or os.fstat(descriptor).st_ino != lock_path.stat().st_ino:
            raise RuntimeError("Storage identity changed; nothing was reset.")
        settled(root)
        archive = Path(tempfile.mkdtemp(prefix=root.name + "-reset-", dir=root.parent))
        print(f"Recoverable archive: {archive}", flush=True)
        saved = archive / "workspace"
        saved.mkdir(mode=0o700)
        receipt = os.open(archive / "reset.jsonl", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        # Missing marker blocks startup if a move fails partway through.
        entries = [MARKER] + sorted(p.name for p in root.iterdir() if p.name not in (MARKER, "shell.lock"))
        with os.fdopen(receipt, "w") as file:
            file.write(json.dumps({"event": "workspace_reset.started", "at": datetime.now(timezone.utc).isoformat(),
                                   "data_dir": str(root), "confirmation": "--yes" if args.yes else "RESET"}) + "\n")
            file.flush()
            os.fsync(file.fileno())
            for name in entries:
                os.rename(root / name, saved / name)
            file.write(json.dumps({"event": "workspace_reset.archived", "at": datetime.now(timezone.utc).isoformat()}) + "\n")
            file.flush()
            os.fsync(file.fileno())
        marker = os.open(root / MARKER, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(marker, "wb") as file:
            file.write(MARKER_BYTES)
            file.flush()
            os.fsync(file.fileno())
        for path in (saved, archive, root, root.parent):
            directory = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
        print("Reset complete. Reopen Cuckoding with this same data directory for a fresh workspace.")
        print("Retained Git branches/worktree registrations are unchanged; the archive keeps their original records.")
    finally:
        os.close(descriptor)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, sqlite3.Error) as error:
        raise SystemExit(str(error)) from None
