#!/bin/sh
set -eu
PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
export PATH
cd "$(dirname "$0")/.."
# Mix and Tauri overlay releases; recreate generated output to drop removed dependencies.
rtk proxy python3 - <<'PY'
from pathlib import Path
import shutil
import subprocess

generated = [
    Path.cwd() / "_build/prod/rel/cuckoding",
    Path.cwd() / "desktop/src-tauri/target/release/bundle/macos/Cuckoding.app",
]
executables = subprocess.check_output(["ps", "-axo", "comm="], text=True).splitlines()
for directory in generated:
    if any(path.strip().startswith(str(directory) + "/") for path in executables):
        raise SystemExit("Cuckoding is running from this release or bundle. Quit it before rebuilding.")
    if directory.resolve() != directory:
        raise SystemExit("Refusing to replace linked generated output.")
for directory in generated:
    if directory.exists():
        shutil.rmtree(directory)
PY
rtk mix deps.get --check-locked
rtk mix assets.setup
# The upstream standalone Tailwind binary has a stale ad-hoc signature on macOS.
rtk proxy codesign --force --sign - _build/tailwind-macos-arm64-4.3.0
rtk proxy env MIX_ENV=prod mix assets.deploy
rtk proxy env MIX_ENV=prod mix compile --warnings-as-errors
rtk proxy env MIX_ENV=prod mix release --overwrite
rtk mkdir -p desktop/resources
# Only replace generated bundle resources, never the application's data directory.
rtk proxy rm -rf desktop/resources/release
rtk proxy cp -R _build/prod/rel/cuckoding desktop/resources/release
# Homebrew OTP links crypto to OpenSSL. Relocate that one non-system dependency.
rtk mkdir -p desktop/resources/release/vendor
rtk proxy cp /opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib desktop/resources/release/vendor/
rtk proxy cp /opt/homebrew/opt/openssl@3/LICENSE.txt desktop/resources/release/vendor/OPENSSL-LICENSE.txt
rtk proxy install_name_tool -id @loader_path/libcrypto.3.dylib desktop/resources/release/vendor/libcrypto.3.dylib
rtk proxy codesign --force --sign - desktop/resources/release/vendor/libcrypto.3.dylib
for library in desktop/resources/release/lib/crypto-*/priv/lib/*.so; do
  rtk proxy install_name_tool -change /opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib @loader_path/../../../../vendor/libcrypto.3.dylib "$library"
  rtk proxy codesign --force --sign - "$library"
done
# Tauri must be able to overwrite its staged resources on the next build.
rtk proxy chmod -R u+w desktop/resources/release
cd desktop
rtk cargo tauri build --bundles app --ci -- --locked
# Seal the complete development bundle after Tauri has copied every resource.
rtk proxy codesign --force --sign - src-tauri/target/release/bundle/macos/Cuckoding.app
rtk proxy codesign --verify --deep --strict src-tauri/target/release/bundle/macos/Cuckoding.app
