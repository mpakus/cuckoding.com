#!/usr/bin/env sh
# Build and run Cuckoding in hot-reload mode (Phoenix CodeReloader + Tauri window).
set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$root"

export MIX_ENV="${MIX_ENV:-dev}"
# Always use the repo target dir. Cursor injects a CARGO_TARGET_DIR under
# /var/folders; macOS /var -> /private/var, and Tauri StartingBinary aborts
# sidecar setup when current_exe() contains that symlink.
export CARGO_TARGET_DIR="$root/src-tauri/target"

exec mix ex_tauri.dev "$@"
